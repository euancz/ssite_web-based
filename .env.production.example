SUPABASE_S3_REGION=
SUPABASE_S3_ENDPOINT=
SUPABASE_PRIVATE_BUCKET=ssite-private
SUPABASE_PUBLIC_BUCKET=ssite-public
SUPABASE_PUBLIC_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
