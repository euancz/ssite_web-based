APP_NAME=SSITE
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-production-host.example
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
