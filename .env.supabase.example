# Merge these values into .env; keep APP_KEY and other existing app settings.
DB_CONNECTION=pgsql
# Copy the Session pooler host/username from Supabase > Connect.
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD="YOUR_DATABASE_PASSWORD"
DB_SSLMODE=require

MEDIA_STORAGE=supabase
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_PROJECT_REGION
SUPABASE_S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
SUPABASE_S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
SUPABASE_PUBLIC_BUCKET=ssite-public
SUPABASE_PRIVATE_BUCKET=ssite-private
SUPABASE_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/ssite-public
